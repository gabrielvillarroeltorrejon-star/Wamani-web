# Configuración del Servidor Backend Wamani
PORT=3001
NODE_ENV=development

# Configuración de URLs
FRONTEND_URL=http://localhost:5173
PRODUCTION_FRONTEND_URL=https://wamani.cl

# Configuración Transbank Webpay Plus
# Para ambiente de Integración (Pruebas), se usan las credenciales públicas oficiales de Transbank:
# Commerce Code: 597055555532
# API Key: 579B532A7440BB063079DED945F63E22AFD11A5FD53A474E83623606EA7AB382
# Environment: INTEGRATION / PRODUCTION
TRANSBANK_ENVIRONMENT=INTEGRATION
TRANSBANK_COMMERCE_CODE=597055555532
TRANSBANK_API_KEY=579B532A7440BB063079DED945F63E22AFD11A5FD53A474E83623606EA7AB382

# Configuración de Correo SMTP (Para envío de Vouchers / Confirmaciones)
# Puede ser Gmail SMTP, SendGrid, Mailgun, Resend, Zoho, o tu hosting cPanel
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contacto@wamani.cl
SMTP_PASS=tu_password_de_aplicacion_aqui
SMTP_FROM="Wamani Experience <contacto@wamani.cl>"
ADMIN_NOTIFICATION_EMAIL=reservas@wamani.cl
