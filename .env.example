# 1. Supabase (Base de Datos en la Nube)
# Obtenlas en https://supabase.com -> Project Settings -> API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_anonima_publica_de_supabase

# 2. API / Backend
# En Vercel: déjalo vacío o usa tu dominio (las funciones Serverless responden en /api/*)
# En desarrollo local: http://localhost:3001 o vacío para rutas relativas
VITE_API_URL=
VITE_SITE_URL=https://wamani.cl

# 3. Transbank Webpay Plus (Variables para Vercel Settings -> Environment Variables)
# Ambiente: PRODUCTION (Ventas Reales) / INTEGRATION (Pruebas)
TRANSBANK_ENVIRONMENT=PRODUCTION
TRANSBANK_COMMERCE_CODE=597053104647
TRANSBANK_API_KEY=07845f9a-aefe-442f-9fb9-054bfca3629f

# 4. Correo Transaccional (Para envío automático de Vouchers)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contacto@wamani.cl
SMTP_PASS=tu_password_de_aplicacion_gmail
SMTP_FROM="Wamani Experience <contacto@wamani.cl>"
ADMIN_NOTIFICATION_EMAIL=reservas@wamani.cl
